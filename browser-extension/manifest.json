{
  "manifest_version": 3,
  "name": "藏页 · 连接当前Chrome",
  "version": "0.5.6",
  "description": "由你点击，将所选平台登录状态直接交给本机藏页，不生成Cookie文件。",
  "permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.youtube.com/*",
    "https://*.douyin.com/*",
    "https://*.iesdouyin.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.xiaoheihe.cn/*",
    "https://*.xiaohongshu.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
